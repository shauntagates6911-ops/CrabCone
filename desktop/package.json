{
  "name": "crabcone-desktop",
  "version": "0.1.0",
  "description": "CrabCone packaged as a desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.shauntagates6911.crabcone",
    "files": [
      "**/*"
      "../index.html",
      "../examples",
      "../LESSONS"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.jpeg"
    }
  }
}
